<Window x:Class="TallyPrimeConnector.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tally Prime Connector" Height="760" Width="1180" WindowStartupLocation="CenterScreen"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#172033"><StackPanel Margin="16"><TextBlock Text="Tally Prime Connector" FontSize="20" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,16"/><ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedPage}" BorderThickness="0"/></StackPanel></Border><ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding SelectedPage}" FontSize="28" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Margin="0,20,0,0"><TextBlock Text="{Binding PageDescription}" FontSize="16" TextWrapping="Wrap"/><Border Margin="0,18,0,0" Padding="18" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6"><StackPanel><TextBlock Text="Connection diagnostics" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="Host" VerticalAlignment="Center"/><TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="10,0"/><TextBlock Text="Port" VerticalAlignment="Center"/><TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="10,0"/><Button Content="Test Connection" Command="{Binding TestConnectionCommand}"/><Button Content="Load Companies" Command="{Binding LoadCompaniesCommand}"/></StackPanel><TextBlock Text="{Binding ConnectionResult}" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Margin="0,14,0,0" Padding="18" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6"><StackPanel><TextBlock Text="Company → Groups → Ledgers" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><ComboBox ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany}" DisplayMemberPath="Name" Width="220"/><Button Content="Load Groups" Command="{Binding LoadGroupsCommand}"/><ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name" Width="220"/><Button Content="Load Ledgers" Command="{Binding LoadLedgersCommand}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBox Text="{Binding LedgerSearch, UpdateSourceTrigger=PropertyChanged}" Width="220"/><ComboBox ItemsSource="{Binding FilteredLedgers}" SelectedItem="{Binding SelectedLedger}" DisplayMemberPath="Name" Width="260" Margin="10,0"/></StackPanel><TextBlock Text="{Binding ExtractionStatus}" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Margin="0,14,0,0" Padding="18" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6"><StackPanel><TextBlock Text="Read-only transaction extraction" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="From" VerticalAlignment="Center"/><TextBox Text="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="8,0"/><TextBlock Text="To" VerticalAlignment="Center"/><TextBox Text="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="8,0"/><Button Content="Extract" Command="{Binding ExtractCommand}"/><Button Content="Cancel" Command="{Binding CancelExtractionCommand}"/></StackPanel><DataGrid ItemsSource="{Binding Vouchers}" AutoGenerateColumns="True" IsReadOnly="True" Height="170" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></Grid></ScrollViewer></Grid></Window>
