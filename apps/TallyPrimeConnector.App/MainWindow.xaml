<Window x:Class="TallyPrimeConnector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tally Prime Connector"
        Width="1280"
        Height="860"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F1F5F9"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#005FB8" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SelectStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHoverBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F8FAFC" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E2E8F0" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LedgerRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="#F1F5F9" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#F0F9FF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" PreviewMouseLeftButtonDown="TitleBar_OnPreviewMouseLeftButtonDown">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Border Width="18" Height="18" Background="{StaticResource AccentBrush}" CornerRadius="4" VerticalAlignment="Center"><TextBlock Text="T" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="Tally Prime Connector" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                    <TextBlock Text="Read-only bridge" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="#94A3B8" />
                </StackPanel>
                <Border Grid.Column="1" Width="310" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#E2E8F0" CornerRadius="5">
                    <Grid Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="15" Foreground="#94A3B8" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Search commands, ledgers, or tasks..." Margin="6,0" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="Ctrl+K" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" /></Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Border VerticalAlignment="Center" Margin="0,0,12,0" Padding="8,3" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBlock Text="Gateway " FontSize="10" FontWeight="SemiBold" Foreground="#047857" /><TextBlock Text="{Binding Port}" FontSize="10" FontWeight="SemiBold" Foreground="#047857" /></StackPanel></Border>
                    <Button Width="44" BorderThickness="0" Background="Transparent" Content="—" FontSize="14" Click="Minimize_OnClick" />
                    <Button Width="44" BorderThickness="0" Background="Transparent" Content="□" FontSize="13" Click="Maximize_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,16,12,8">
                        <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="30" Height="30" Background="#0284C7" CornerRadius="7"><TextBlock Text="▣" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Tally Bridge" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" /><TextBlock Text="Online when gateway responds" FontSize="10" Foreground="#059669" /></StackPanel></Grid>
                        <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedPage}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavigationItemStyle}" />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Margin="12" Padding="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,7,0" /><TextBlock Text="TallyPrime Gateway" FontSize="11" FontWeight="SemiBold" Foreground="#334155" /></StackPanel>
                            <TextBlock Margin="14,3,0,0" Text="HTTP/XML endpoint configured locally" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" />
                            <Border Height="1" Background="#F1F5F9" Margin="0,9,0,7" />
                            <DockPanel><TextBlock Text="Server: {Binding Host}" FontSize="10" Foreground="#64748B" /><TextBlock DockPanel.Dock="Right" Text="Logs" FontSize="10" Foreground="{StaticResource AccentBrush}" /></DockPanel>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,22,28,30">
                    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Connector" FontSize="11" Foreground="#64748B" /><TextBlock Text="  ›  " FontSize="11" Foreground="#94A3B8" /><TextBlock Text="{Binding SelectedPage}" FontSize="11" FontWeight="SemiBold" Foreground="#475569" /></StackPanel><TextBlock Text="Connection and ledger export" FontSize="24" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0" /><TextBlock Text="{Binding PageDescription}" FontSize="12" Foreground="#64748B" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource SecondaryButtonStyle}" Content="Docs" Margin="0,0,8,0" /><Button Style="{StaticResource PrimaryButtonStyle}" Content="↻  Reconnect / Sync" Command="{Binding TestConnectionCommand}" /></StackPanel></Grid>

                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,15"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Border Width="31" Height="31" Background="#F0F9FF" BorderBrush="#E0F2FE" BorderThickness="1" CornerRadius="6"><TextBlock Text="⌁" FontSize="17" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="9,0"><TextBlock Text="Connection Diagnostics" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" /><TextBlock Text="Verify local HTTP/XML communication with TallyPrime" FontSize="11" Foreground="#64748B" /></StackPanel></StackPanel><Border DockPanel.Dock="Right" Padding="8,4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12"><TextBlock Text="Read-only endpoint" FontSize="10" Foreground="#475569" /></Border></DockPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource LabelStyle}" Text="Host / IP Address" /><TextBox Style="{StaticResource InputStyle}" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource LabelStyle}" Text="Port" /><TextBox Style="{StaticResource InputStyle}" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Style="{StaticResource PrimaryButtonStyle}" Content="▷  Test Connection" Command="{Binding TestConnectionCommand}" Margin="0,0,8,0" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="⇣  Load Companies" Command="{Binding LoadCompaniesCommand}" /></StackPanel></Grid>
                            <Border Margin="0,14,0,0" Padding="10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"><TextBlock Text="{Binding ConnectionResult}" FontFamily="Consolas" FontSize="11" Foreground="#047857" TextWrapping="Wrap" /></Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,15"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Border Padding="7,3" Background="#E0F2FE" CornerRadius="4"><TextBlock Text="Hierarchy" FontSize="10" FontWeight="SemiBold" Foreground="#075985" /></Border><TextBlock Text="Company  →  Groups  →  Ledgers" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" /></StackPanel><TextBlock DockPanel.Dock="Right" Text="Choose exact ledger names for export" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" /></DockPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.4*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.5*" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource LabelStyle}" Text="Company" /><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Content="Load Groups" Command="{Binding LoadGroupsCommand}" Margin="8,0,0,0" /><ComboBox Style="{StaticResource SelectStyle}" ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany}" DisplayMemberPath="Name" /></DockPanel></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource LabelStyle}" Text="Group filter" /><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Content="Load Ledgers" Command="{Binding LoadLedgersCommand}" Margin="8,0,0,0" /><ComboBox Style="{StaticResource SelectStyle}" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name" /></DockPanel></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource LabelStyle}" Text="Quick filter" /><TextBox Style="{StaticResource InputStyle}" Text="{Binding LedgerSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter ledger names" /></StackPanel></Grid>
                            <Border Margin="0,16,0,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="33" /><RowDefinition Height="180" /><RowDefinition Height="34" /></Grid.RowDefinitions><Grid Background="#F8FAFC"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><TextBlock Text="Ledger Name" Margin="12,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#475569" /><TextBlock Grid.Column="1" Text="Parent Group" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#475569" /><TextBlock Grid.Column="2" Text="Opening Balance" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#475569" /><TextBlock Grid.Column="3" Text="Closing Balance" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#475569" /></Grid><ListBox Grid.Row="1" ItemsSource="{Binding FilteredLedgerSelections}" BorderThickness="0" ItemContainerStyle="{StaticResource LedgerRowStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="12,0" Height="36"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"><TextBlock Text="{Binding Ledger.Name}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="6,0,0,0" /></CheckBox><TextBlock Grid.Column="1" Text="{Binding Ledger.GroupName}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Ledger.OpeningBalance, StringFormat={}{0:N2}}" FontFamily="Consolas" FontSize="11" Foreground="#475569" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="{Binding Ledger.ClosingBalance, StringFormat={}{0:N2}}" FontFamily="Consolas" FontSize="11" Foreground="#475569" VerticalAlignment="Center" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><DockPanel Grid.Row="2" Background="#F8FAFC"><TextBlock Text="{Binding ExtractionStatus}" Margin="12,0" VerticalAlignment="Center" FontSize="11" Foreground="#475569" TextTrimming="CharacterEllipsis" /><TextBlock DockPanel.Dock="Right" Text="Exact ledger membership" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource AccentBrush}" /></DockPanel></Grid></Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15"><Border Width="31" Height="31" Background="#ECFDF5" BorderBrush="#D1FAE5" BorderThickness="1" CornerRadius="6"><TextBlock Text="▤" FontSize="16" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="9,0"><TextBlock Text="Read-Only Ledger-Wise Excel Export" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" /><TextBlock Text="Verified date-scoped Tally vouchers, exact client-side ledger membership, one sheet per ledger" FontSize="11" Foreground="#64748B" /></StackPanel></StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width=".8*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource LabelStyle}" Text="From date (YYYY-MM-DD)" /><TextBox Style="{StaticResource InputStyle}" Text="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource LabelStyle}" Text="To date (YYYY-MM-DD)" /><TextBox Style="{StaticResource InputStyle}" Text="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Style="{StaticResource LabelStyle}" Text="Batch days" /><TextBox Style="{StaticResource InputStyle}" Text="{Binding BatchDays, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Style="{StaticResource PrimaryButtonStyle}" Content="⇣  Extract and Export" Command="{Binding ExtractCommand}" Margin="0,0,8,0" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Command="{Binding CancelExtractionCommand}" /></StackPanel></Grid>
                            <Border Height="1" Background="#F1F5F9" Margin="0,15" />
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Target workbook path (.xlsx)" /><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource SecondaryButtonStyle}" Content="▣  Choose Excel File" Command="{Binding ChooseExportPathCommand}" Margin="8,0,0,0" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="↗  Reveal Workbook" Command="{Binding RevealExportCommand}" Margin="8,0,0,0" /></StackPanel><TextBox Style="{StaticResource InputStyle}" Text="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" /></DockPanel>
                            <TextBlock Margin="0,9,0,0" Text="The connector writes a new XLSX workbook. Tally data is only requested through read-only EXPORT / COLLECTION." FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding Vouchers}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="180" Margin="0,15,0,0" BorderBrush="#E2E8F0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="100" /><DataGridTextColumn Header="Voucher type" Binding="{Binding VoucherType}" Width="150" /><DataGridTextColumn Header="Voucher number" Binding="{Binding VoucherNumber}" Width="150" /><DataGridTextColumn Header="Party ledger" Binding="{Binding PartyLedger}" Width="*" /><DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="2*" /></DataGrid.Columns></DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
