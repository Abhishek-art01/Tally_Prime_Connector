<Window x:Class="TallyPrimeConnector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TallyPrimeConnector.App"
        Title="Tally Prime Connector"
        Icon="Assets/tally-connector-icon.png"
        Width="1080"
        Height="700"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="Manual"
        Background="#F1F5F9"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#0067C0" />
        <SolidColorBrush x:Key="Border" Color="#E2E8F0" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>

        <Style x:Key="Select" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>

        <Style x:Key="DateInput" TargetType="DatePicker">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#005FB8" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F8FAFC" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#E2E8F0" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="White" /><Setter Property="Foreground" Value="{StaticResource Accent}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" ClipToBounds="True">
            <DockPanel Margin="12,16">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Image Width="40" Height="30" Source="Assets/tally-connector-logo.png" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="Tally Connector" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" />
                    </Grid>
                    <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Read-only" FontSize="10" Foreground="#64748B" />
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="ContentScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" PanningDeceleration="0.001" PanningRatio="1" PreviewMouseWheel="ContentScrollViewer_PreviewMouseWheel">
            <StackPanel Margin="24,20,24,30">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SecondaryButton}" Content="☰" FontSize="16" Padding="9,3" Command="{Binding ToggleSidebarCommand}" />
                    <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="Tally Prime Connector" FontSize="21" FontWeight="SemiBold" Foreground="#0F172A" /><TextBlock Text="{Binding SelectedPage}" FontSize="11" Foreground="#64748B" /></StackPanel>
                    <Border Grid.Column="2" Padding="8,4" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBlock Text="{Binding Host}" FontSize="10" Foreground="#047857" /><TextBlock Text=":" FontSize="10" Foreground="#047857" /><TextBlock Text="{Binding Port}" FontSize="10" Foreground="#047857" /></StackPanel></Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Host" /><TextBox Style="{StaticResource Input}" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Port" /><TextBox Style="{StaticResource Input}" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Style="{StaticResource PrimaryButton}" Content="Test" Command="{Binding TestConnectionCommand}" Margin="0,0,8,0" /><Button Style="{StaticResource SecondaryButton}" Content="Load company" Command="{Binding LoadCompaniesCommand}" /></StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding ConnectionResult}" Margin="4,-8,4,14" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2.4*" /><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Company" /><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Groups" Command="{Binding LoadGroupsCommand}" Margin="8,0,0,0" /><ComboBox Style="{StaticResource Select}" ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany}" DisplayMemberPath="Name" /></DockPanel></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Group" /><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Ledgers" Command="{Binding LoadLedgersCommand}" Margin="8,0,0,0" /><ComboBox Style="{StaticResource Select}" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name" /></DockPanel></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="Filter" /><TextBox Style="{StaticResource Input}" Text="{Binding LedgerSearch, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        </Grid>
                        <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="31" /><RowDefinition Height="210" /></Grid.RowDefinitions>
                                <Grid Background="#F8FAFC"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions><DockPanel Margin="12,0,6,0"><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Select all" Height="25" Padding="7,3" Margin="0,3,8,3" Command="{Binding SelectAllLedgersCommand}" /><TextBlock Text="Ledger" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#475569" /></DockPanel><TextBlock Grid.Column="1" Text="Opening" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#475569" /><TextBlock Grid.Column="2" Text="Closing" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#475569" /></Grid>
                                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredLedgerSelections}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="12,0" Height="35"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"><TextBlock Text="{Binding Ledger.Name}" FontSize="12" Foreground="#1E293B" Margin="6,0,0,0" /></CheckBox><TextBlock Grid.Column="1" Text="{Binding Ledger.OpeningBalance, StringFormat={}{0:N2}}" FontFamily="Consolas" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Ledger.ClosingBalance, StringFormat={}{0:N2}}" FontFamily="Consolas" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding ExtractionStatus}" Margin="4,10,4,0" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width=".7*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="From" /><local:IndianDatePicker Style="{StaticResource DateInput}" SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="To" /><local:IndianDatePicker Style="{StaticResource DateInput}" SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Batch days" /><TextBox Style="{StaticResource Input}" Text="{Binding BatchDays, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Style="{StaticResource PrimaryButton}" Content="Export Excel" Command="{Binding ExtractCommand}" Margin="0,0,8,0" /><Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelExtractionCommand}" /></StackPanel>
                        </Grid>
                        <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource SecondaryButton}" Content="Choose file" Command="{Binding ChooseExportPathCommand}" Margin="8,0,0,0" /><Button Style="{StaticResource SecondaryButton}" Content="Reveal" Command="{Binding RevealExportCommand}" Margin="8,0,0,0" /></StackPanel><TextBox Style="{StaticResource Input}" Text="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" /></DockPanel>
                        <Expander Header="Preview" Margin="0,14,0,0"><DataGrid ItemsSource="{Binding Vouchers}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="160" Margin="0,8,0,0" BorderBrush="{StaticResource Border}"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="95" /><DataGridTextColumn Header="Type" Binding="{Binding VoucherType}" Width="130" /><DataGridTextColumn Header="Number" Binding="{Binding VoucherNumber}" Width="130" /><DataGridTextColumn Header="Party" Binding="{Binding PartyLedger}" Width="*" /></DataGrid.Columns></DataGrid></Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
